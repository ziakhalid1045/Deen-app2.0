rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAppAdmin() {
      return isSignedIn() && request.auth.token.email == 'ziakhalid1614@gmail.com';
    }

    // --- Message Validation ---
    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             isValidId(data.chatId) &&
             (data.content is string || data.mediaUrl is string) &&
             (data.status == null || data.status in ['sent', 'delivered', 'read']) &&
             data.createdAt != null;
    }

    // --- Chat Validation ---
    function isValidChat(data) {
      return data.participants is list &&
             data.participants.size() == 2 &&
             data.participants.hasAny([request.auth.uid]) &&
             data.lastMessageAt != null &&
             data.updatedAt != null;
    }

    // --- User Roles & Validation ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.displayName is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isAppAdmin() || isOwner(userId);
      allow update: if isAppAdmin() || (isOwner(userId) && 
                        incoming().uid == existing().uid &&
                        incoming().email == existing().email &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'displayName', 'bio', 'photoURL', 'coverURL', 'updatedAt', 'postsCount', 
                          'followersCount', 'followingCount', 'lastViewedInbox', 'country', 'isPrivate'
                        ])
                      ) ||
                      (isSignedIn() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['followersCount'])
                      );
      
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(followerId);
      }

      match /following/{followingId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(blockedId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn(); // Allow create for mentions/likes/system
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }

      match /savedPosts/{postId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // --- App Config ---
    match /appConfig/{configId} {
      allow read: if true; // Public check for version/APK
      allow write: if isAppAdmin();
    }

    // --- Posts ---
    function isValidPost(data) {
      return data.authorId == request.auth.uid &&
             (data.content is string || data.imageUrl is string || data.videoUrl is string) &&
             (data.mediaType == null || data.mediaType in ['image', 'video', 'raw']) &&
             (data.isShort == null || data.isShort is bool) &&
             (data.videoDuration == null || data.videoDuration is number) &&
             (data.privacy == null || data.privacy in ['public', 'private']);
    }

    match /posts/{postId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (resource.data.get('privacy', 'public') != 'private' || resource.data.authorId == request.auth.uid || isAppAdmin());
      allow create: if isSignedIn() && isValidPost(incoming()) && incoming().createdAt == request.time;
      allow update: if isAppAdmin() || (isSignedIn() && (
        // Author updating content
        (existing().authorId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['content']) && 
         isValidPost(incoming())) ||
        // System incrementing counts or others liking/commenting
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount']))
      ));
      allow delete: if isAppAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
                        incoming().authorId == request.auth.uid &&
                        incoming().content is string && incoming().content.size() <= 2000 &&
                        incoming().createdAt == request.time;
      }

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // --- Friend Requests ---
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isSignedIn() && 
                      incoming().fromId == request.auth.uid &&
                      incoming().status == 'pending' &&
                      !exists(/databases/$(database)/documents/users/$(incoming().toId)/blockedUsers/$(request.auth.uid)) &&
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                      (existing().toId == request.auth.uid || existing().fromId == request.auth.uid) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn() && (existing().fromId == request.auth.uid || existing().toId == request.auth.uid);
    }

    // --- Chats ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAppAdmin());
      allow write: if isAppAdmin() || (isSignedIn() && isValidId(chatId) && (resource == null || resource.data.participants.hasAny([request.auth.uid])));
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAppAdmin());
        allow create: if isAppAdmin() || (isSignedIn() && isValidMessage(incoming()) && 
                        getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]));
        allow delete: if isAppAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
      }
    }
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                      incoming().authorId == request.auth.uid &&
                      incoming().mediaUrl is string &&
                      incoming().createdAt is timestamp;
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }
    match /reports/{reportId} {
      allow read: if isAppAdmin() || (isSignedIn() && existing().reporterId == request.auth.uid);
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAppAdmin();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAppAdmin() {
      return request.auth != null && request.auth.token.email == 'ziakhalid1614@gmail.com';
    }

    match /app/apks/{allPaths=**} {
      allow read: if true;
      allow write: if isAppAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024; // 50MB limit for general
    }
  }
}
